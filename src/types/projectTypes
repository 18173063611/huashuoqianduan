export interface ProjectItem {
  projectId: number
  projectName: string
  description: string | null
  status: 'DRAFT' | 'MAKING' | 'DONE'
  createdAt: string
  updatedAt: string
}

export interface CreateProjectRequest {
  projectName: string
  description?: string
}

export interface UpdateProjectRequest {
  projectName: string
  description?: string
  status?: ProjectItem['status']
}
