SERVER_PUBLIC_IP=你的服务器公网IP
VITE_API_BASE_URL=http://你的服务器公网IP:8080/api/v1
VITE_WS_BASE_URL=ws://你的服务器公网IP:8080/ws

# 宠物创作中心临时可见账号，填写 userId，多个账号用英文逗号分隔；正式上线优先使用后端 PET_CREATION_ACCESS 权限点。
VITE_PET_CREATION_ALLOWED_USER_IDS=

# 宠物创作中心接口模式：mock=仅前端模拟；auto=优先真实接口失败回退 mock；real=只走真实接口。
VITE_PET_CREATION_API_MODE=real
